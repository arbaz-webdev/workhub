# Copy to apps/api/.env for local development.

PORT=4000
NODE_ENV=development

# How many proxies sit in front of the API: "loopback" locally; on Render "3"
# (Cloudflare, Render's load balancer, then the web app). Rate limits and office-IP rules need the real visitor IP.
TRUST_PROXY=loopback

# Browser origin allowed to call the API (the Next.js app).
WEB_ORIGIN=http://localhost:3000
# Public URL of the web app, used in email links and the Google redirect URL.
APP_URL=http://localhost:3000

# Email: "console" prints emails to the API log (development). "resend" sends them.
EMAIL_TRANSPORT=console
EMAIL_FROM=WorkHub <no-reply@localhost>
# RESEND_API_KEY=re_...
# Production refuses "console" unless this is set: for a staging site without a mail domain.
# ALLOW_CONSOLE_EMAIL=true

# File attachments. "local" stores files in .data/uploads (development only).
# For production use "s3" with AWS S3 or Cloudflare R2 (set S3_ENDPOINT for R2:
# https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto).
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Product analytics (PostHog), sent from the server with hashed ids and no personal data.
# Off unless POSTHOG_KEY is set. POSTHOG_HOST defaults to PostHog's EU cloud.
# POSTHOG_KEY=phc_...
# POSTHOG_HOST=https://eu.i.posthog.com

# Encrypts two-factor (authenticator app) secrets. Required in production; any long random
# string (e.g. `openssl rand -base64 32`). Changing it turns off everyone's two-factor sign-in.
# TOTP_ENCRYPTION_KEY=

# Redis, once more than one API copy runs: rate limits are counted across all of them and
# live chat and board updates reach people connected to any copy. Unset: kept in memory.
# REDIS_URL=redis://localhost:6379

# Where the in-app feedback button's messages are emailed. Without it they're only saved
# in the feedback table (read it with the admin connection).
# FEEDBACK_TO=founders@example.com

# Billing. Plan limits apply unless BILLING_ENFORCED=false (e.g. for a free beta).
# BILLING_ENFORCED=true
# How invoices are paid online: "test" (a pretend checkout; the default outside production)
# or "none". Production refuses "test" unless ALLOW_TEST_PAYMENTS=true (staging only).
# PAYMENTS_DRIVER=test
# Who invoices are from.
# SELLER_NAME=WorkHub
# SELLER_NTN=
# SELLER_ADDRESS=
# SELLER_EMAIL=billing@workhub.pk
# Bank transfer (IBFT) for annual plans is offered once an IBAN is set.
# BANK_NAME=
# BANK_ACCOUNT_TITLE=
# BANK_IBAN=
# WorkHub staff who confirm bank transfers at /app/platform (comma-separated emails).
# PLATFORM_ADMINS=
# Sales tax on services by province (percent), to override the defaults. Confirm the
# current rates with a tax adviser before charging anyone.
# SALES_TAX_RATES={"punjab":16,"sindh":15}

# Google sign-in is enabled only when both are set. In Google Cloud Console create an
# OAuth client (Web application) with this authorised redirect URI:
#   http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Admin connection: runs migrations and owns the tables.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/workhub

# Restricted connection the API uses. Row-Level Security always applies to this user.
# Instead of the full URL you can set APP_DB_PASSWORD: it is then built from DATABASE_URL
# with the user workhub_app (what render.yaml does).
# The migrate script creates the user with this password.
DATABASE_APP_URL=postgres://workhub_app:workhub_app_dev@localhost:5433/workhub
