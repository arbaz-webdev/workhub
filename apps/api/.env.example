# Copy to apps/api/.env for local development.

PORT=4000
NODE_ENV=development

# Browser origin allowed to call the API (the Next.js app).
WEB_ORIGIN=http://localhost:3000
# Public URL of the web app, used in email links and the Google redirect URL.
APP_URL=http://localhost:3000

# Email: "console" prints emails to the API log (development). "resend" sends them.
EMAIL_TRANSPORT=console
EMAIL_FROM=WorkHub <no-reply@localhost>
# RESEND_API_KEY=re_...

# Google sign-in is enabled only when both are set. In Google Cloud Console create an
# OAuth client (Web application) with this authorised redirect URI:
#   http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Admin connection: runs migrations and owns the tables.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/workhub

# Restricted connection the API uses. Row-Level Security always applies to this user.
# The migrate script creates the user with this password.
DATABASE_APP_URL=postgres://workhub_app:workhub_app_dev@localhost:5433/workhub
