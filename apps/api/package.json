{
  "name": "@workhub/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1153.0",
    "@aws-sdk/s3-request-presigner": "3.1153.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@node-rs/argon2": "2.2.2",
    "@workhub/shared": "*",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "write-excel-file": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15"
  },
  "jest": {
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^@workhub/shared$": "<rootDir>/../../packages/shared/src"
    },
    "setupFiles": [
      "<rootDir>/test/env.ts"
    ],
    "globalSetup": "<rootDir>/test/global-setup.ts",
    "testTimeout": 30000
  }
}
